<?xml version="1.0" encoding="UTF-8"?>
<!-- Running-specific ActivityExtension/v2 fields: TPX RunCadence (no base Cadence
     element, so it must populate "cadence" via the collision-fallback rule) and LX
     lap fields (AvgRunCadence, MaxRunCadence, Steps, AvgSpeed, AvgWatts, MaxWatts). -->
<TrainingCenterDatabase xmlns="http://www.garmin.com/xmlschemas/TrainingCenterDatabase/v2"
    xmlns:ns3="http://www.garmin.com/xmlschemas/ActivityExtension/v2">
  <Activities>
    <Activity Sport="Running">
      <Id>2026-01-05T08:00:00Z</Id>
      <Lap StartTime="2026-01-05T08:00:00Z">
        <TotalTimeSeconds>2.0</TotalTimeSeconds>
        <DistanceMeters>10.0</DistanceMeters>
        <Calories>5</Calories>
        <Intensity>Active</Intensity>
        <TriggerMethod>Manual</TriggerMethod>
        <Extensions>
          <ns3:LX>
            <ns3:AvgSpeed>3.0</ns3:AvgSpeed>
            <ns3:AvgRunCadence>85</ns3:AvgRunCadence>
            <ns3:MaxRunCadence>90</ns3:MaxRunCadence>
            <ns3:Steps>300</ns3:Steps>
            <ns3:AvgWatts>250</ns3:AvgWatts>
            <ns3:MaxWatts>260</ns3:MaxWatts>
          </ns3:LX>
        </Extensions>
        <Track>
          <Trackpoint>
            <Time>2026-01-05T08:00:00Z</Time>
            <Position>
              <LatitudeDegrees>37.0000</LatitudeDegrees>
              <LongitudeDegrees>-122.0000</LongitudeDegrees>
            </Position>
            <HeartRateBpm><Value>140</Value></HeartRateBpm>
            <Extensions>
              <!-- CadenceSensor is an attribute of TPX itself in ActivityExtension/v2 -->
              <ns3:TPX CadenceSensor="Footpod">
                <ns3:Speed>3.0</ns3:Speed>
                <ns3:RunCadence>85</ns3:RunCadence>
                <ns3:Watts>250</ns3:Watts>
              </ns3:TPX>
            </Extensions>
          </Trackpoint>
          <Trackpoint>
            <Time>2026-01-05T08:00:01Z</Time>
            <Position>
              <LatitudeDegrees>37.0001</LatitudeDegrees>
              <LongitudeDegrees>-122.0001</LongitudeDegrees>
            </Position>
            <HeartRateBpm><Value>141</Value></HeartRateBpm>
            <Extensions>
              <ns3:TPX CadenceSensor="Footpod">
                <ns3:Speed>3.0</ns3:Speed>
                <ns3:RunCadence>86</ns3:RunCadence>
                <ns3:Watts>255</ns3:Watts>
              </ns3:TPX>
            </Extensions>
          </Trackpoint>
        </Track>
      </Lap>
    </Activity>
  </Activities>
</TrainingCenterDatabase>
