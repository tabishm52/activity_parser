<?xml version="1.0" encoding="UTF-8"?>
<!-- A vendor attribute literally named "type" on an element outside any Trackpoint, so
     it ends up in the extra dict. Only genuine xsi:type should be skipped there too. -->
<TrainingCenterDatabase xmlns="http://www.garmin.com/xmlschemas/TrainingCenterDatabase/v2"
    xmlns:ns3="urn:example:vendor"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Activities>
    <Activity ns3:type="vendor-real-data" xsi:type="SomeSchemaType" Sport="Biking">
      <Id>2026-01-05T08:00:00Z</Id>
      <Lap StartTime="2026-01-05T08:00:00Z">
        <TotalTimeSeconds>1.0</TotalTimeSeconds>
        <DistanceMeters>5.0</DistanceMeters>
      </Lap>
    </Activity>
  </Activities>
</TrainingCenterDatabase>
