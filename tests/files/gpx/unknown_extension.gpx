<?xml version="1.0" encoding="UTF-8"?>
<!-- A made-up vendor extension in a namespace this library doesn't know about: the
     leaf should still be collected, namespace-qualified, as an uncoerced string. -->
<gpx creator="activity_parser tests" version="1.1"
    xmlns="http://www.topografix.com/GPX/1/1">
  <trk>
    <name>Unknown Extension Track</name>
    <trkseg>
      <trkpt lat="37.0000" lon="-122.0000">
        <ele>10.0</ele>
        <time>2026-01-05T08:00:00Z</time>
        <extensions>
          <stress xmlns="urn:example:unknown-vendor">42</stress>
        </extensions>
      </trkpt>
      <trkpt lat="37.0001" lon="-122.0001">
        <ele>11.0</ele>
        <time>2026-01-05T08:00:01Z</time>
        <extensions>
          <stress xmlns="urn:example:unknown-vendor">43</stress>
        </extensions>
      </trkpt>
    </trkseg>
  </trk>
</gpx>
