<?xml version="1.0" encoding="UTF-8"?>
<!-- Exercises trk/type as a Strava display name ("Ride") rather than a FIT-shaped value -->
<gpx creator="Strava" version="1.1"
    xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <time>2026-01-05T08:00:00Z</time>
  </metadata>
  <trk>
    <name>Evening Ride</name>
    <type>Ride</type>
    <trkseg>
      <trkpt lat="37.0000" lon="-122.0000">
        <ele>10.0</ele>
        <time>2026-01-05T08:00:00Z</time>
      </trkpt>
    </trkseg>
  </trk>
</gpx>
